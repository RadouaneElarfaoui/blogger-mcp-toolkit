# ==========================================
# Blogger MCP Toolkit - Environment Variables
# ==========================================

# 1. Google Cloud OAuth 2.0 Client ID (Required)
# Go to Google Cloud Console -> APIs & Services -> Credentials
# Example: 1234567890-abcd1234efgh5678ijkl.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# 2. Google Cloud OAuth 2.0 Client Secret (Required)
# Found in the same place as the Client ID
GOOGLE_CLIENT_SECRET=your-client-secret

# 3. Google OAuth 2.0 Refresh Token (Required)
# Generate this by running `npm run auth` AFTER setting the two variables above.
# This allows the MCP server to maintain persistent access without manual logins.
GOOGLE_REFRESH_TOKEN=your-refresh-token

# 4. Google API Key (Optional)
# If you only need unauthenticated read-only access to public blogs.
# Typically not needed if using OAuth2.
# GOOGLE_API_KEY=your-api-key
