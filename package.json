{
  "name": "blogger-mcp-toolkit",
  "version": "1.1.1",
  "description": "A universal MCP server for the Google Blogger API v3",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "blogger-mcp-toolkit": "dist/index.js",
    "blogger-mcp-auth": "dist/cli/auth.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "auth": "npx tsx scripts/get-refresh-token.ts",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "dotenv": "^16.4.7",
    "googleapis": "^148.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "keywords": ["mcp", "blogger", "google", "api"],
  "license": "MIT"
}
